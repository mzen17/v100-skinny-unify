+__device__ __forceinline__ __half2 fp8_e4m3_pair_to_half2(uint16_t raw_pair) {
+  // Sign to bit 15/31, exponent+mantissa up by 7. E4M3 bias is 7 vs fp16's 15,
+  // so the result is exactly value * 2^-8 for every finite encoding (verified
+  // exhaustively, denormals included). NaN encodings map to +/-480.
+  const uint32_t p = static_cast<uint32_t>(raw_pair);
+  const uint32_t bits = (((p & 0x0080u) << 8) | ((p & 0x007fu) << 7)) |
+                        (((p & 0x8000u) << 16) | ((p & 0x7f00u) << 15));
+  union { uint32_t u; __half2 h2; } cvt;
+  cvt.u = bits;
+  return cvt.h2;
+}
+
+__device__ __forceinline__ __half2 load_fp8_e4m3_half2_unscaled(
+    const void* __restrict__ cache, const int64_t byte_index) {
+  const uint16_t* cache_u16 = reinterpret_cast<const uint16_t*>(cache);
+  return fp8_e4m3_pair_to_half2(cache_u16[byte_index >> 1]);
+}
+
 __device__ __forceinline__ float fp8_e5m2_to_float(uint8_t raw) {
   return __half2float(fp8_e5m2_to_half(raw));
 }
